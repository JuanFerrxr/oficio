# Copia este archivo como .env y llena los valores.
# En local los imprime `npx supabase status` (en la raíz del proyecto).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=pega-aqui-la-anon-key
# ¡Secreta! Salta todas las reglas RLS. Nunca va en la app móvil ni en Git.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key
# Cualquier texto largo y aleatorio. Lo usa Cloud Scheduler para llamar a /jobs/*
CRON_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
PORT=8080
# Sprint 4B · notificaciones push. Con 3000, la API revisa la cola de avisos cada 3 s y los manda
# por Expo Push. 0 = no mandar solos (en producción los dispara Cloud Scheduler con /jobs/enviar-avisos).
AVISOS_CADA_MS=3000

# Sprint 5A · IA. Todo es opcional: sin estas llaves la app funciona igual, sin IA.
# ¡Secretas! Nunca van en la app ni en Git.
# Claude (Anthropic) · asistente de solicitud. Llave en https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=sk-ant-...
# Sin llave de Claude, IA_DEMO=true muestra respuestas de ejemplo (sin costo) para ver las pantallas.
IA_DEMO=true
# Voyage AI · búsqueda por significado (embeddings). Llave en https://www.voyageai.com
# VOYAGE_API_KEY=pa-...
