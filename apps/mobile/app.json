{
  "expo": {
    "name": "Oficio",
    "slug": "oficio",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mx.oficio.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mx.oficio.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F8FC",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Oficio usa tu ubicación para mostrarte prestadores cercanos, para marcar tu zona de trabajo si ofreces servicios y para compartirla en el chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Oficio necesita tus fotos para tu foto de perfil, tus documentos, tus solicitudes y el chat.",
          "cameraPermission": "Oficio usa la cámara para tu foto de perfil, la selfie de verificación, tus documentos y para mandar fotos o video en el chat.",
          "microphonePermission": "Oficio usa el micrófono para grabar video en el chat."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1F4FD1"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Oficio usa el micrófono para grabar notas de voz en el chat con tu prestador o cliente."
        }
      ]
    ],
    "scheme": "oficio",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f01f0e93-0406-4c52-9384-52c7c29a2c72"
      }
    },
    "owner": "juanferrxr"
  }
}
