# Copia este archivo como .env, o mejor: desde la raíz del proyecto corre
#   powershell -ExecutionPolicy Bypass -File scripts\crear-env-mobile.ps1
# El iPhone NO puede usar 127.0.0.1 (para el teléfono, esa dirección es el propio teléfono):
# va la IP de tu computadora en tu Wi-Fi.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.50:54321
# Llave pública (ANON_KEY de `npx supabase status -o env`). Es pública por diseño:
# la seguridad la ponen las reglas RLS de la base, no esta llave. NUNCA pongas aquí la service role.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=pega-aqui-la-llave-publica
